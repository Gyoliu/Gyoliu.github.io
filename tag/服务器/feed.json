            "url": "https://blog.genesisx.cn/2026/09/24/%E8%BF%90%E7%BB%B4/%E6%9C%8D%E5%8A%A1%E5%99%A8%E7%9B%91%E6%8E%A7%E5%BC%80%E6%BA%90%E9%A1%B9%E7%9B%AE%E9%80%89%E5%9E%8B/",
            "title": "服务器监控开源项目选型",
            "date_published": "2026-09-24T15:38:39.000Z",
            "content_html": "<h1 id=\"项目需求对比\"><a href=\"#项目需求对比\" class=\"headerlink\" title=\"项目需求对比\"></a>项目需求对比</h1><table>\n<thead>\n<tr>\n<th>需求</th>\n<th align=\"right\">Beszel</th>\n<th align=\"right\">Netdata</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>CPU &#x2F; 内存 &#x2F; Load</td>\n<td align=\"right\">✅</td>\n<td align=\"right\">✅</td>\n</tr>\n<tr>\n<td>磁盘容量</td>\n<td align=\"right\">✅</td>\n<td align=\"right\">✅</td>\n</tr>\n<tr>\n<td>磁盘 I&#x2F;O</td>\n<td align=\"right\">✅</td>\n<td align=\"right\">✅ 更细</td>\n</tr>\n<tr>\n<td>网络流量</td>\n<td align=\"right\">✅</td>\n<td align=\"right\">✅ 更细</td>\n</tr>\n<tr>\n<td>Docker 容器</td>\n<td align=\"right\">✅</td>\n<td align=\"right\">✅</td>\n</tr>\n<tr>\n<td>基础告警</td>\n<td align=\"right\">✅</td>\n<td align=\"right\">✅</td>\n</tr>\n<tr>\n<td>历史趋势</td>\n<td align=\"right\">✅</td>\n<td align=\"right\">✅</td>\n</tr>\n<tr>\n<td>多服务器集中</td>\n<td align=\"right\">✅</td>\n<td align=\"right\">✅ Parent</td>\n</tr>\n<tr>\n<td>MySQL 深度指标</td>\n<td align=\"right\">❌</td>\n<td align=\"right\"><strong>✅</strong></td>\n</tr>\n<tr>\n<td>Redis 深度指标</td>\n<td align=\"right\">❌</td>\n<td align=\"right\"><strong>✅</strong></td>\n</tr>\n<tr>\n<td>Nginx QPS&#x2F;连接数</td>\n<td align=\"right\">❌</td>\n<td align=\"right\"><strong>✅</strong></td>\n</tr>\n<tr>\n<td>Elasticsearch</td>\n<td align=\"right\">❌</td>\n<td align=\"right\"><strong>✅</strong></td>\n</tr>\n<tr>\n<td>JVM &#x2F; Tomcat</td>\n<td align=\"right\">❌</td>\n<td align=\"right\"><strong>✅</strong></td>\n</tr>\n<tr>\n<td>Kafka &#x2F; RabbitMQ</td>\n<td align=\"right\">❌</td>\n<td align=\"right\"><strong>✅</strong></td>\n</tr>\n<tr>\n<td>进程级诊断</td>\n<td align=\"right\">基础</td>\n<td align=\"right\"><strong>强</strong></td>\n</tr>\n<tr>\n<td>秒级排障</td>\n<td align=\"right\">一般</td>\n<td align=\"right\"><strong>强</strong></td>\n</tr>\n<tr>\n<td>运维复杂度</td>\n<td align=\"right\"><strong>低</strong></td>\n<td align=\"right\">中高</td>\n</tr>\n<tr>\n<td>Agent 权限&#x2F;攻击面</td>\n<td align=\"right\"><strong>较小</strong></td>\n<td align=\"right\">更大</td>\n</tr>\n<tr>\n<td>资源消耗</td>\n<td align=\"right\"><strong>低</strong></td>\n<td align=\"right\">更高</td>\n</tr>\n</tbody></table>\n<h1 id=\"场景对比\"><a href=\"#场景对比\" class=\"headerlink\" title=\"场景对比\"></a>场景对比</h1><table>\n<thead>\n<tr>\n<th>推荐等级</th>\n<th>项目</th>\n<th>核心定位</th>\n<th>最适合场景</th>\n<th>优点</th>\n<th>缺点 &#x2F; 注意点</th>\n<th>许可证</th>\n</tr>\n</thead>\n<tbody><tr>\n<td><strong>首选</strong></td>\n<td><strong>Prometheus + Grafana</strong></td>\n<td>现代指标监控 + 可视化黄金组合</td>\n<td>云原生、Kubernetes、容器、微服务、动态环境</td>\n<td>生态最强（Exporter 海量）、PromQL 强大、可扩展性极好、社区活跃</td>\n<td>需自己组装（Prometheus 采集 + Grafana 展示 + Alertmanager 告警），初期配置有学习成本</td>\n<td>Apache 2.0 &#x2F; AGPL</td>\n</tr>\n<tr>\n<td><strong>企业级一体机</strong></td>\n<td><strong>Zabbix</strong></td>\n<td>全功能企业级监控平台</td>\n<td>传统服务器 + 网络设备 + 混合环境、大规模主机</td>\n<td>开箱即用（Agent&#x2F;Agentless&#x2F;SNMP&#x2F;IPMI&#x2F;JMX）、模板丰富、自动发现、告警完善、可扩展到万级主机</td>\n<td>对 K8s&#x2F;微服务支持相对较弱，UI 相对传统</td>\n<td>AGPL&#x2F;GPL</td>\n</tr>\n<tr>\n<td><strong>实时轻量</strong></td>\n<td><strong>Netdata</strong></td>\n<td>零配置实时性能监控</td>\n<td>单机或小规模服务器、故障排查、实时查看</td>\n<td>安装极快（分钟级）、秒级粒度、自动发现服务、内置漂亮 UI、资源占用可控</td>\n<td>大规模集中监控需配合其他工具，默认更侧重单机深度</td>\n<td>GPL-3.0</td>\n</tr>\n<tr>\n<td><strong>轻量新星</strong></td>\n<td><strong>Beszel</strong></td>\n<td>超轻量服务器监控</td>\n<td>1–20 台服务器、家用&#x2F;小型环境</td>\n<td>资源占用极低（Agent 约 10–15 MB）、部署简单、界面清爽</td>\n<td>功能相对聚焦，不如 Prometheus&#x2F;Zabbix 全面</td>\n<td>MIT</td>\n</tr>\n<tr>\n<td><strong>可用性&#x2F;状态页</strong></td>\n<td><strong>Uptime Kuma</strong></td>\n<td>服务可用性 + 状态页</td>\n<td>监控网站&#x2F;API 是否存活、对外状态页</td>\n<td>单容器部署、支持多种协议、通知渠道极多、界面友好</td>\n<td>主要做可用性，不做深度系统指标</td>\n<td>MIT</td>\n</tr>\n</tbody></table>\n<h2 id=\"Beszel-0-20-0部署\"><a href=\"#Beszel-0-20-0部署\" class=\"headerlink\" title=\"Beszel 0.20.0部署\"></a>Beszel 0.20.0部署</h2><blockquote>\n<p>Beszel       0.20.0<br>Kubernetes   v1.21.14<br>Replica      1<br>Database     PocketBase &#x2F; SQLite</p>\n</blockquote>\n<hr>\n<h3 id=\"数据存储-01-storage-yaml-，使用-Local-File-SQLite\"><a href=\"#数据存储-01-storage-yaml-，使用-Local-File-SQLite\" class=\"headerlink\" title=\"数据存储 01-storage.yaml ，使用 Local File SQLite\"></a>数据存储 01-storage.yaml ，使用 Local File SQLite</h3><pre class=\"line-numbers language-javascript\" data-language=\"javascript\"><code class=\"language-javascript\"><span class=\"token literal-property property\">apiVersion</span><span class=\"token operator\">:</span> v1\n<span class=\"token literal-property property\">kind</span><span class=\"token operator\">:</span> Namespace\n<span class=\"token literal-property property\">metadata</span><span class=\"token operator\">:</span>\n  <span class=\"token literal-property property\">name</span><span class=\"token operator\">:</span> beszel\n<span class=\"token operator\">--</span><span class=\"token operator\">-</span>\n<span class=\"token literal-property property\">apiVersion</span><span class=\"token operator\">:</span> storage<span class=\"token punctuation\">.</span>k8s<span class=\"token punctuation\">.</span>io<span class=\"token operator\">/</span>v1\n<span class=\"token literal-property property\">kind</span><span class=\"token operator\">:</span> StorageClass\n<span class=\"token literal-property property\">metadata</span><span class=\"token operator\">:</span>\n  <span class=\"token literal-property property\">name</span><span class=\"token operator\">:</span> beszel<span class=\"token operator\">-</span>local\n<span class=\"token literal-property property\">provisioner</span><span class=\"token operator\">:</span> kubernetes<span class=\"token punctuation\">.</span>io<span class=\"token operator\">/</span>no<span class=\"token operator\">-</span>provisioner\n<span class=\"token literal-property property\">volumeBindingMode</span><span class=\"token operator\">:</span> WaitForFirstConsumer\n<span class=\"token literal-property property\">reclaimPolicy</span><span class=\"token operator\">:</span> Retain\n<span class=\"t